# Copia este archivo como ".env" en local (o configura estas mismas variables
# en el panel de tu proveedor de hosting: Vercel o Cloudflare Pages) y rellena
# tus valores reales. NUNCA subas un archivo ".env" real a GitHub ni lo compartas.

# --- Envío del formulario por email (Resend) ---
# Funciona igual en Vercel y en Cloudflare Pages (API HTTP, no SMTP).
# Cuenta gratis en https://resend.com — ver README paso 3.
RESEND_API_KEY=tu-clave-de-resend
# Dirección remitente: debe ser de un dominio verificado en Resend, o usa
# "onboarding@resend.dev" solo para probar mientras verificas el tuyo.
CONTACT_FROM_EMAIL=web@tu-dominio.com
# Dirección donde quieres recibir los mensajes del formulario (tu correo real)
CONTACT_TO_EMAIL=tu-correo@gmail.com

# --- hCaptcha (clave SECRETA del servidor, nunca la clave pública) ---
# Se obtiene en https://dashboard.hcaptcha.com
HCAPTCHA_SECRET=tu-clave-secreta-de-hcaptcha

# --- Límite de peticiones distribuido (opcional, recomendado) ---
# Cuenta gratis en https://upstash.com (Redis). Si dejas estas dos vacías,
# la función usa un límite en memoria más débil como respaldo automático.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
